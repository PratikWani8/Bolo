# ==========================================
# BOLO - Universal Environment Configuration
# ==========================================

# -----------------
# Node.js Server
# -----------------
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/bolo
JWT_SECRET=bolo_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# -----------------
# AI Microservice (FastAPI)
# -----------------
AI_PORT=8000
AI_HOST=0.0.0.0
AI_ENV=development
# Primary LLM Provider: groq (recommended) or fallback mock
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Speech to Text Provider: whisper, groq_whisper, or browser_speech
STT_PROVIDER=groq_whisper
# Text to Speech Provider: gtts, edge_tts, or indic_tts
TTS_PROVIDER=gtts
# Embedding & RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_TYPE=faiss
CHROMA_PERSIST_DIRECTORY=./app/data/vector_store
CONFIDENCE_THRESHOLD=0.65

# -----------------
# React Client (Vite)
# -----------------
VITE_API_URL=http://localhost:5000/api
VITE_AI_URL=http://localhost:8000/api
VITE_APP_NAME=BOLO
VITE_DEFAULT_LANGUAGE=mr
